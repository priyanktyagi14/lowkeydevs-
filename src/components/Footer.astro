<footer class="bg-[#FFFFFF] dark:bg-[#0B0817] border-t border-[#E2DCED] dark:border-[#261F3D] mt-auto relative z-20 transition-colors duration-200">
  <div class="w-full max-w-[1440px] mx-auto px-6 sm:px-8 md:px-12 lg:px-16 py-14 md:py-20">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12">
      <!-- Brand & Mission -->
      <div class="col-span-1 md:col-span-5 flex flex-col justify-between">
        <div>
          <a href="/" class="flex items-center gap-2.5 mb-3 cursor-pointer group">
            <svg height="22" viewBox="0 0 200 150" width="29" xmlns="http://www.w3.org/2000/svg">
              <path d="
                M0 0
                L80 0
                L100 75
                L120 150
                L200 150
                L180 75
                L100 75
                L20 75
                Z
              " fill="#7C4DFF"></path>
            </svg>
            <span class="font-normal text-base text-pastel-text-title dark:text-[#F5F2FC] group-hover:text-pastel-primary dark:group-hover:text-[#8F66FF] transition-colors">lowkeydevs</span>
          </a>
          <p class="text-xs font-light text-pastel-text-body dark:text-[#BDB6D4] max-w-sm leading-relaxed">
            Crafting premium software, AI solutions and digital experiences for high-growth teams worldwide.
          </p>
