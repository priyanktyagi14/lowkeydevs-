        <p class="text-[11px] font-light text-pastel-text-muted dark:text-[#7E7699] mt-8 md:mt-0">
          &copy; 2026 Lowkeydevs. All rights reserved.
        </p>
      </div>
      
      <!-- Footer Columns -->
      <div class="col-span-1 md:col-span-7 grid grid-cols-2 sm:grid-cols-3 gap-8">
        <div class="flex flex-col gap-3">
          <h4 class="text-[10px] font-medium uppercase tracking-widest text-pastel-text-title dark:text-[#F5F2FC] mb-1">Navigation</h4>
          <a class="text-xs font-light text-pastel-text-body dark:text-[#BDB6D4] hover:text-pastel-primary dark:hover:text-[#8F66FF] transition-colors duration-200" href="/">Home</a>
          <a class="text-xs font-light text-pastel-text-body dark:text-[#BDB6D4] hover:text-pastel-primary dark:hover:text-[#8F66FF] transition-colors duration-200" href="/portfolio">Portfolio</a>
          <a class="text-xs font-light text-pastel-text-body dark:text-[#BDB6D4] hover:text-pastel-primary dark:hover:text-[#8F66FF] transition-colors duration-200" href="/labs">Labs</a>
          <a class="text-xs font-light text-pastel-text-body dark:text-[#BDB6D4] hover:text-pastel-primary dark:hover:text-[#8F66FF] transition-colors duration-200" href="/project-detail">Case Study</a>
        </div>
        <div class="flex flex-col gap-3">
          <h4 class="text-[10px] font-medium uppercase tracking-widest text-pastel-text-title dark:text-[#F5F2FC] mb-1">Connect</h4>
          <a class="text-xs font-light text-pastel-text-body dark:text-[#BDB6D4] hover:text-pastel-primary dark:hover:text-[#8F66FF] transition-colors duration-200" href="/contact">Contact</a>
          <a class="text-xs font-light text-pastel-text-body dark:text-[#BDB6D4] hover:text-pastel-primary dark:hover:text-[#8F66FF] transition-colors duration-200" href="https://twitter.com" target="_blank" rel="noopener noreferrer">Twitter</a>
          <a class="text-xs font-light text-pastel-text-body dark:text-[#BDB6D4] hover:text-pastel-primary dark:hover:text-[#8F66FF] transition-colors duration-200" href="https://linkedin.com" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a class="text-xs font-light text-pastel-text-body dark:text-[#BDB6D4] hover:text-pastel-primary dark:hover:text-[#8F66FF] transition-colors duration-200" href="https://github.com" target="_blank" rel="noopener noreferrer">GitHub</a>
        </div>
        <div class="flex flex-col gap-3">
          <h4 class="text-[10px] font-medium uppercase tracking-widest text-pastel-text-title dark:text-[#F5F2FC] mb-1">Studio</h4>
          <span class="text-xs font-light text-pastel-text-body dark:text-[#BDB6D4]">Los Angeles, CA</span>
          <span class="text-xs font-light text-pastel-text-body dark:text-[#BDB6D4]">Remote-First Studio</span>
          <a href="mailto:hello@lowkeydevs.com" class="text-xs font-normal text-pastel-primary dark:text-[#8F66FF] hover:underline">hello@lowkeydevs.com</a>
        </div>
