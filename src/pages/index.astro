    year: "2024",
    image: "https://lh3.googleusercontent.com/aida-public/AB6AXuBkqGJFSvOVPCpzVBBtelG7SwHb28_2VpQyumyqzOj3Sbk31n-GC_hJDUeV5tdsCzK5MZTwLW6dwex2H6lZgY4Pv9HdX-SRxqAL-1iloUw_yHq791IMQ14jezl635NG-J2Vk0Kblc2GLu53y_rPE2YwsHGYnPEF2iYTvgHjVoiOJrB5x5BxGXt6hpJalkYPlWWj8zYj22qBgjcm2C7ljgffDFzYDPn53jTIPbMFycWaoB8c90KKv0zzA3qxf6NFd6VshKo",
    href: "/project-detail",
    offset: true
