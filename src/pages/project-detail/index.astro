---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Nebula AI Platform - Case Study - Lowkeydevs" currentPage="portfolio">
  <main class="flex-grow z-10 relative pt-28 md:pt-36 pb-24">
    <!-- Hero Section -->
    <section class="max-w-[1440px] mx-auto px-6 sm:px-8 md:px-12 lg:px-16 mb-16 md:mb-20">
      <div class="max-w-3xl mb-10 md:mb-14 pt-4">
        <div class="hero-badge inline-flex items-center gap-2 px-3 py-1 rounded-[6px] bg-[#FFFFFF] dark:bg-[#151028] border border-[#E2DCED] dark:border-[#261F3D] text-xs font-normal text-pastel-text-title dark:text-[#F5F2FC] mb-5 shadow-sm">
          <span class="w-2 h-2 rounded-full bg-[#7C4DFF]"></span>
          <span class="tracking-widest uppercase text-[10px] text-pastel-primary dark:text-[#8F66FF] font-medium">Case Study &bull; Nebula Labs</span>
        </div>
        <h1 class="hero-title text-4xl sm:text-5xl lg:text-6xl font-light text-pastel-text-title dark:text-[#F5F2FC] leading-[1.12] tracking-tight mb-5">
          Nebula <span class="font-normal text-[#7C4DFF] dark:text-[#8F66FF]">AI Platform</span>.
        </h1>
        <p class="hero-text text-sm sm:text-base font-light text-pastel-text-body dark:text-[#BDB6D4] max-w-2xl leading-relaxed">
          Architecting a high-performance generative analytics platform with sub-millisecond data pipeline visualization and collaborative model exploration.
        </p>
      </div>

      <!-- Hero Image Showcase -->
      <div class="w-full aspect-[16/9] md:aspect-[21/9] rounded-[10px] overflow-hidden border border-[#E2DCED] dark:border-[#261F3D] bg-[#EDE8F5] dark:bg-[#1A1433] flex items-center justify-center relative group shadow-pastel-card">
        <img 
          alt="Nebula AI Platform interface preview" 
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.02]" 
          src="https://lh3.googleusercontent.com/aida-public/AB6AXuCTD_z-okJk87GG0O7ukYdfAG_j9Y7Xm14MediV21Kn2StYc1zcajjll2_quXgxRoIY50rspqPcPqTifB0Ec231YorANvLKk2HpHugYippuv7SvWBwteNxIuxdpv83NtYutTz81Dpbls1yDTNxPPSZCpEuAGQmI7qK9z537zmW73ehDrU8xAQ87HN5mSKOGFiUipNPf3R833qY-DYZzVivQj_RrJBwLjy4Gi6j3u6nDoHb-3qXwyHqFIHKCEPEuGyCOztc"
        />
        
        <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
          <div class="w-16 h-16 rounded-[8px] bg-[#FFFFFF]/90 dark:bg-[#151028]/90 backdrop-blur-md border border-[#E2DCED] dark:border-[#261F3D] flex items-center justify-center shadow-pastel-md text-pastel-primary dark:text-[#8F66FF]">
            <span class="material-symbols-outlined text-2xl ml-0.5" style="font-variation-settings: 'FILL' 1;">play_arrow</span>
          </div>
        </div>
      </div>

      <!-- Quick Stats / Meta -->
      <div class="gsap-stat-card grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8 mt-8 pt-8 border-t border-[#E2DCED] dark:border-[#261F3D]">
        <div>
          <div class="text-[10px] font-medium text-pastel-text-muted dark:text-[#7E7699] uppercase tracking-widest mb-1.5">Client</div>
          <div class="text-xs sm:text-sm font-normal text-pastel-text-title dark:text-[#F5F2FC]">Nebula Technologies</div>
        </div>
        <div>
          <div class="text-[10px] font-medium text-pastel-text-muted dark:text-[#7E7699] uppercase tracking-widest mb-1.5">Role</div>
          <div class="text-xs sm:text-sm font-normal text-pastel-text-title dark:text-[#F5F2FC]">Design &amp; Engineering</div>
        </div>
        <div>
          <div class="text-[10px] font-medium text-pastel-text-muted dark:text-[#7E7699] uppercase tracking-widest mb-1.5">Timeline</div>
          <div class="text-xs sm:text-sm font-normal text-pastel-text-title dark:text-[#F5F2FC]">10 Weeks</div>
        </div>
        <div>
          <div class="text-[10px] font-medium text-pastel-text-muted dark:text-[#7E7699] uppercase tracking-widest mb-1.5">Live Release</div>
          <a class="text-xs sm:text-sm font-medium text-pastel-primary dark:text-[#8F66FF] hover:underline inline-flex items-center gap-1" href="#">
            <span>Visit Platform</span>
            <span class="material-symbols-outlined text-xs">north_east</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Challenge & Solution Bento -->
    <section class="max-w-[1440px] mx-auto px-6 sm:px-8 md:px-12 lg:px-16 mb-20 md:mb-24">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-8">
        <!-- The Challenge -->
        <div class="gsap-bento-item md:col-span-5 bg-[#FFFFFF] dark:bg-[#151028] border border-[#E2DCED] dark:border-[#261F3D] p-7 md:p-9 rounded-[8px] flex flex-col justify-between shadow-pastel-card transition-colors duration-200">
          <div>
            <div class="flex items-center gap-2.5 mb-5">
              <span class="material-symbols-outlined text-[#E11D48] text-[20px]" style="font-variation-settings: 'FILL' 1;">warning</span>
              <h3 class="text-lg md:text-xl font-medium text-pastel-text-title dark:text-[#F5F2FC] tracking-tight">The Challenge</h3>
            </div>
            <p class="text-xs sm:text-sm font-light text-pastel-text-body dark:text-[#BDB6D4] mb-6 leading-relaxed">
              Nebula's enterprise users struggled with complex data topologies and latency-heavy dashboards. The objective was to transform massive multi-dimensional dataset queries into an instantaneous visual canvas that non-technical stakeholders could also manipulate in real-time.
            </p>
          </div>
          
          <div class="space-y-3 pt-4 border-t border-[#E2DCED] dark:border-[#261F3D]">
            <div class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-[#7C4DFF] dark:text-[#8F66FF] text-xs mt-0.5">remove</span>
              <span class="text-xs font-light text-pastel-text-body dark:text-[#BDB6D4]">Heavy client-side rendering bottlenecks on massive node sets.</span>
            </div>
            <div class="flex items-start gap-2.5">
              <span class="material-symbols-outlined text-[#7C4DFF] dark:text-[#8F66FF] text-xs mt-0.5">remove</span>
              <span class="text-xs font-light text-pastel-text-body dark:text-[#BDB6D4]">Disjointed user journeys across analytics configuration pipelines.</span>
            </div>
          </div>
        </div>

        <!-- The Solution -->
        <div class="gsap-bento-item md:col-span-7 bg-[#FFFFFF] dark:bg-[#151028] border border-[#E2DCED] dark:border-[#261F3D] p-7 md:p-9 rounded-[8px] relative overflow-hidden flex flex-col shadow-pastel-card transition-colors duration-200">
          <div class="relative z-10">
            <div class="flex items-center gap-2.5 mb-5">
              <span class="material-symbols-outlined text-[#7C4DFF] dark:text-[#8F66FF] text-[20px]" style="font-variation-settings: 'FILL' 1;">lightbulb</span>
              <h3 class="text-lg md:text-xl font-medium text-pastel-text-title dark:text-[#F5F2FC] tracking-tight">Our Solution</h3>
            </div>
            <p class="text-xs sm:text-sm font-light text-pastel-text-body dark:text-[#BDB6D4] mb-8 leading-relaxed">
              We engineered a bespoke WebGL-accelerated canvas interface coupled with a modular design system. By offloading pipeline rendering to GPU threads and creating streamlined interaction micro-states, query responsiveness improved tenfold.
            </p>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-auto">
              <div class="p-4 rounded-[6px] bg-[#EDE7FB] dark:bg-[#261B48] border border-[#E2DCED] dark:border-[#382B61]">
                <div class="text-2xl font-normal text-pastel-primary dark:text-[#A78BFA] mb-1">10x Faster</div>
                <div class="text-xs font-light text-pastel-text-body dark:text-[#BDB6D4]">Query visualization speed</div>
              </div>
              <div class="p-4 rounded-[6px] bg-[#E1F1FD] dark:bg-[#122A42] border border-[#E2DCED] dark:border-[#1E3A5F]">
                <div class="text-2xl font-normal text-[#0284C7] dark:text-[#38BDF8] mb-1">84%</div>
                <div class="text-xs font-light text-pastel-text-body dark:text-[#BDB6D4]">Increase in team adoption</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Tech Stack -->
    <section class="max-w-[1440px] mx-auto px-6 sm:px-8 md:px-12 lg:px-16 mb-20 md:mb-24">
      <div class="gsap-section-header mb-8">
        <h2 class="text-2xl font-light text-pastel-text-title dark:text-[#F5F2FC] tracking-tight">Technologies &amp; Architecture</h2>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="pastel-card p-5">
          <span class="text-[10px] font-medium uppercase text-pastel-primary dark:text-[#A78BFA] tracking-widest block mb-1">Frontend</span>
          <div class="font-normal text-sm text-pastel-text-title dark:text-[#F5F2FC]">React &bull; WebGL &bull; TypeScript</div>
        </div>
        <div class="pastel-card p-5">
          <span class="text-[10px] font-medium uppercase text-[#0284C7] dark:text-[#38BDF8] tracking-widest block mb-1">Backend</span>
          <div class="font-normal text-sm text-pastel-text-title dark:text-[#F5F2FC]">Rust &bull; Python &bull; gRPC</div>
        </div>
        <div class="pastel-card p-5">
          <span class="text-[10px] font-medium uppercase text-[#0D9488] dark:text-[#2DD4BF] tracking-widest block mb-1">Cloud</span>
          <div class="font-normal text-sm text-pastel-text-title dark:text-[#F5F2FC]">AWS &bull; Docker &bull; Redis</div>
        </div>
        <div class="pastel-card p-5">
          <span class="text-[10px] font-medium uppercase text-[#D97706] dark:text-[#FBBF24] tracking-widest block mb-1">Animations</span>
          <div class="font-normal text-sm text-pastel-text-title dark:text-[#F5F2FC]">GSAP &bull; Three.js &bull; Tailwind</div>
        </div>
      </div>
    </section>

    <!-- Next Project Navigation -->
    <section class="max-w-[1440px] mx-auto px-6 sm:px-8 md:px-12 lg:px-16 pt-8 border-t border-[#E2DCED] dark:border-[#261F3D]">
      <div class="flex flex-col sm:flex-row justify-between items-center gap-6">
        <div>
          <span class="text-[10px] font-medium text-pastel-text-muted dark:text-[#7E7699] uppercase tracking-widest">Next Project</span>
          <h3 class="text-2xl font-light text-pastel-text-title dark:text-[#F5F2FC] mt-1">Echo Protocol &rarr;</h3>
        </div>
        <a 
          href="/portfolio" 
          class="px-6 py-3 rounded-[6px] bg-[#FFFFFF] dark:bg-[#151028] border border-[#E2DCED] dark:border-[#261F3D] text-pastel-text-title dark:text-[#F5F2FC] hover:border-pastel-primary dark:hover:border-[#8F66FF] hover:text-pastel-primary dark:hover:text-[#8F66FF] text-xs font-normal transition-all"
        >
          Back to all projects
        </a>
      </div>
    </section>
  </main>
</Layout>
