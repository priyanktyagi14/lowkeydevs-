const categories = ["All Projects", "AI Products", "SaaS Platforms", "Web Apps", "Brand & Design"];
---

<Layout title="Portfolio - Lowkeydevs" currentPage="portfolio">
  <main class="flex-grow pt-28 md:pt-36 pb-24 px-6 sm:px-8 md:px-12 lg:px-16 relative z-10 w-full max-w-[1440px] mx-auto">
    <!-- Header -->
    <header class="mb-14 md:mb-18 max-w-3xl pt-4">
      <div class="hero-badge inline-flex items-center gap-2 px-3 py-1 rounded-[6px] bg-[#FFFFFF] dark:bg-[#151028] border border-[#E2DCED] dark:border-[#261F3D] text-xs font-normal text-pastel-text-title dark:text-[#F5F2FC] mb-5 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-[#7C4DFF]"></span>
        <span class="tracking-widest uppercase text-[10px] text-pastel-primary dark:text-[#8F66FF] font-medium">Curated Portfolio</span>
      </div>
      <h1 class="hero-title text-4xl sm:text-5xl lg:text-6xl font-light text-pastel-text-title dark:text-[#F5F2FC] leading-[1.12] tracking-tight mb-5">
        Crafting digital <br/><span class="font-normal text-[#7C4DFF] dark:text-[#8F66FF]">experiences</span>.
      </h1>
      <p class="hero-text text-sm sm:text-base font-light text-pastel-text-body dark:text-[#BDB6D4] max-w-2xl leading-relaxed">
        A curated selection of our recent projects, spanning AI products, SaaS platforms, and digital brand experiences for ambitious companies.
      </p>

      <!-- Category Filter Tabs -->
      <div class="flex flex-wrap gap-2.5 pt-8">
        {categories.map((cat, idx) => (
          <button 
            class={`px-4 py-2 rounded-[6px] text-xs font-medium transition-all duration-200 ${idx === 0 ? 'bg-[#7C4DFF] text-white shadow-pastel-sm' : 'bg-[#FFFFFF] dark:bg-[#151028] border border-[#E2DCED] dark:border-[#261F3D] text-pastel-text-body dark:text-[#BDB6D4] hover:border-pastel-primary dark:hover:border-[#8F66FF] hover:text-pastel-primary dark:hover:text-[#8F66FF]'}`}
          >
            {cat}
          </button>
        ))}
      </div>
    </header>

    <!-- Project Grid -->
    <div class="gsap-card-grid grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-10">
      {projects.map((project) => (
        <ProjectCard {...project} />
      ))}
    </div>
  </main>
</Layout>
